---
import ProjectCard from "@components/ProjectCard.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedProjects } from "@utils/content-utils";

const projects = await getSortedProjects();
const title = i18n(I18nKey.projects);
---
<MainGridLayout title={title} description={title}>
    <div class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6 mb-4">
        <h1 class="relative font-bold text-3xl text-90 md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-[0.6rem] before:-left-[1.125rem]">
            {title}
        </h1>
        <div class="text-50 text-sm mt-1">{projects.length}</div>
    </div>

    {projects.length === 0
        ? <div class="card-base rounded-[var(--radius-large)] px-9 py-6 text-75">{i18n(I18nKey.noProjects)}</div>
        : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                {projects.map((entry) => <ProjectCard entry={entry} />)}
            </div>
        )
    }
</MainGridLayout>
