---
import path from "node:path";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedProjects } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getDir, url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";

export async function getStaticPaths() {
	const entries = await getSortedProjects();
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const { title, description, image, tags, demo, repo, published } = entry.data;
---
<MainGridLayout title={title} description={description} headings={headings}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-6 relative w-full">

            <!-- retour -->
            <a href={url("/projects/")}
               class="inline-flex items-center text-sm text-50 hover:text-[var(--primary)] transition mb-4 -ml-1">
                <Icon name="material-symbols:chevron-left-rounded" class="text-xl" />
                {i18n(I18nKey.backToProjects)}
            </a>

            <!-- titre -->
            <div class="relative">
                <h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:-left-[1.125rem]">
                    {title}
                </h1>
            </div>

            <!-- date + tags -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-5 text-sm text-50">
                <span class="flex items-center gap-1.5">
                    <Icon name="material-symbols:calendar-today-outline-rounded" class="text-xl" />
                    {formatDateToYYYYMMDD(published)}
                </span>
                {tags.map((tag) => (
                    <span class="text-xs font-medium px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
                        {tag.trim()}
                    </span>
                ))}
            </div>

            <!-- liens -->
            {(demo || repo) && (
                <div class="flex flex-wrap gap-2 mb-6">
                    {demo && (
                        <a href={demo} target="_blank" rel="noopener noreferrer"
                           class="btn-regular rounded-lg h-10 px-4 font-medium flex items-center gap-2 active:scale-95">
                            <Icon name="fa6-solid:arrow-up-right-from-square" class="text-sm" />
                            {i18n(I18nKey.liveDemo)}
                        </a>
                    )}
                    {repo && (
                        <a href={repo} target="_blank" rel="noopener noreferrer"
                           class="btn-plain rounded-lg h-10 px-4 font-medium flex items-center gap-2 active:scale-95">
                            <Icon name="fa6-brands:github" class="text-lg" />
                            {i18n(I18nKey.sourceCode)}
                        </a>
                    )}
                </div>
            )}

            <!-- image de couverture -->
            {image && (
                <ImageWrapper
                    src={image}
                    basePath={path.join("content/projects/", getDir(entry.id))}
                    alt={title}
                    class="mb-8 rounded-xl aspect-[16/9]"
                />
            )}

            <!-- contenu Markdown -->
            <Markdown class="mb-2 markdown-content">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
